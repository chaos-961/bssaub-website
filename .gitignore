node_modules/
dist/
.vite/
*.log
.DS_Store
Thumbs.db

# Raw source uploads — converted/renamed into public/assets/ during build sessions (§4).
# Kept local on purpose; raw screenshots and full-size PNGs never ship.
/assets/

# Firestore security rules (v0.4.8, user call). Untracked on purpose: the rules
# name the admin account's email address, which is the one thing about the
# admin gate deliberately kept out of a public repo (it travels inside the
# encrypted payload instead, see scripts/build-admin-payload.mjs). The rules
# are pasted into the Firebase console by hand and the console is where they
# live; this file is the local copy to edit and paste from.
firestore.rules

# Local tooling
.claude/
run-local.bat

# The admin secret (v0.5.6, user call). BSS_ADMIN_PASSWORD and BSS_ADMIN_EMAIL
# for scripts/build-admin-payload.mjs and scripts/check-admin-password.mjs, so
# the two admin commands can be run without typing a live credential onto a
# command line every time. Loaded by node's own --env-file-if-exists, which is
# why no dotenv dependency appears anywhere for it.
#
# NOT named .env.anything on purpose: Vite loads .env, .env.local, .env.<mode>
# and .env.<mode>.local from this directory, and while it only ever exposes
# VITE_ prefixed values to client code, the safest file is the one its env
# loader has no pattern for at all.
#
# It is a plaintext secret on one machine. Rule 8 is unchanged by it: this
# never gets committed, and the password still lives nowhere in the tracked
# repo. If the machine is shared or the file is ever copied off it, rotate the
# password and re-run npm run admin:payload.
.admin.env
